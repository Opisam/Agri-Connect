# AgriConnect Mobile - Environment Configuration
# Copy to .env.local and adjust values for your environment.
# Note: EXPO_PUBLIC_* variables are inlined at build time.

# Base URL for the AgriConnect API (the IP of your dev machine):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1