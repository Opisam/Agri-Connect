# AgriConnect Backend - Environment Configuration
# Copy to .env and adjust values for your environment.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-real-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Use sqlite:///db.sqlite3 for local dev (default).
# Use postgres://user:password@localhost:5432/agriconnect for PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False